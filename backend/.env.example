# ก๊อปเป็น backend/.env แล้วใส่ค่าจริง (ห้าม commit .env และห้ามใส่ค่าจริงในไฟล์นี้ — ไฟล์นี้ถูก commit)

PORT=3000
# หน้าเว็บที่อนุญาตให้เรียก API (หลายโดเมนคั่นด้วย , เช่น http://localhost:5173,https://pawhome.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Supabase Dashboard → Connect → Session pooler (port 5432) — ใส่รหัสผ่านฐานข้อมูลแทน [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Dashboard → Project Settings → API (Project URL ไม่ต้องมี /rest/v1)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# service role / secret key: ข้าม RLS ได้ทั้งหมด ใช้ฝั่ง Backend เท่านั้น ห้ามใส่ใน frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

STORAGE_BUCKET=pet-images

# หน้าเว็บที่ลิงก์ยืนยันอีเมลพากลับมา (ไม่ใส่ = ใช้โดเมนแรกของ CORS_ORIGIN)
# ต้องเพิ่ม <APP_URL>/login ใน Supabase → Authentication → URL Configuration → Redirect URLs
APP_URL=http://localhost:5173

# อยู่หลัง reverse proxy (Render, Railway, Nginx ฯลฯ) ให้ใส่จำนวน proxy เช่น 1 · รันตรงในเครื่อง = false
# false = ไม่เชื่อ X-Forwarded-For (กันการปลอม IP หลบ rate limit)
TRUST_PROXY=false

# จำนวนครั้งต่อนาทีต่อ IP (เกินแล้วตอบ 429)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
